# AI AutoPost SEO System - Apache Configuration + WAF
# =====================================================

# Prevent directory listing
Options -Indexes

# Enable rewrite engine
RewriteEngine On

# ── Force HTTPS (active in production via APP_ENV; Apache VirtualHost handles redirect in prod) ──
# Uncomment lines below ONLY if not using the prod VirtualHost config:
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^localhost [NC]
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Block HTTP methods (allow only GET, POST, HEAD) ───────────────────────────
RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD)$
RewriteRule .* - [F,L]

# ── Protect sensitive directories ─────────────────────────────────────────────
RewriteRule ^includes/   - [F,L]
RewriteRule ^config/     - [F,L]
RewriteRule ^jobs/       - [F,L]
RewriteRule ^logs/       - [F,L]
RewriteRule ^\.git/      - [F,L]
RewriteRule ^vendor/     - [F,L]

# ── Block known bad bots and scanners ─────────────────────────────────────────
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|nuclei|dirbuster|gobuster|wfuzz|hydra|metasploit|nessus|openvas|burpsuite|acunetix|arachni|havij|pangolin|beef/|libwww-perl|python-requests/2\.(?:[0-9]|1[0-9])\.|go-http-client/1\.|curl/[0-7]\.) [NC]
RewriteRule .* - [F,L]

# ── Block SQL injection in URL ─────────────────────────────────────────────────
RewriteCond %{QUERY_STRING} (union.+select|select.+from|insert.+into|drop.+table|update.+set|delete.+from|load_file|outfile|into\s+dumpfile) [NC]
RewriteRule .* - [F,L]

# SQL comment injection bypass (uni/**/on sel/**/ect)
RewriteCond %{QUERY_STRING} (un(i(on)?)?\/\*|sel(e(ct?)?)?\s*\/\*|\/\*.*\*\/.*select|\/\*.*\*\/.*union) [NC]
RewriteRule .* - [F,L]

RewriteCond %{QUERY_STRING} (%27|%22|%3C|%3E).*(%3D|%22|%27|%3C|%3E) [NC]
RewriteRule .* - [F,L]

# Double URL encoding attempts (%25 = encoded %)
RewriteCond %{QUERY_STRING} %25[0-9a-fA-F]{2} [NC]
RewriteRule .* - [F,L]

# ── Block LFI / Path Traversal ────────────────────────────────────────────────
RewriteCond %{QUERY_STRING} (\.\./|\.\.%2F|%2e%2e/) [NC]
RewriteRule .* - [F,L]

RewriteCond %{REQUEST_URI} (\.\./|\.\.%2F|%2e%2e/) [NC]
RewriteRule .* - [F,L]

# ── Block XSS patterns in URL ─────────────────────────────────────────────────
RewriteCond %{QUERY_STRING} (<script|javascript:|vbscript:|expression\s*\(|on(error|load|click|mouse)=) [NC]
RewriteRule .* - [F,L]

# ── Block shell injection patterns ────────────────────────────────────────────
RewriteCond %{QUERY_STRING} (;|\||\`).{0,20}(bash|sh|wget|curl|nc|python|perl|php) [NC]
RewriteRule .* - [F,L]

# ── Block access to backup/config file patterns ───────────────────────────────
RewriteCond %{REQUEST_URI} \.(bak|backup|old|orig|save|swp|tmp|~)$ [NC]
RewriteRule .* - [F,L]

RewriteCond %{REQUEST_URI} (wp-login|wp-admin|phpMyAdmin|phpmyadmin|pma|adminer|manager/html|solr/admin|\.well-known/security) [NC]
RewriteRule .* - [F,L]

# ── Block common exploit paths ────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} (eval\(|base64_decode|gzinflate|str_rot13|assert\s*\() [NC]
RewriteRule .* - [F,L]

# ── Protect sensitive files ───────────────────────────────────────────────────
<FilesMatch "\.(env|ini|log|sql|sh|bak|backup|old|orig|save|swp|tmp|key|pem|crt|p12|pfx|htpasswd|htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to hidden files/directories (dot-files)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # Remove server version fingerprint
    Header always unset X-Powered-By
    Header always unset Server

    # Content Security Policy — blocks inline scripts from external origins
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; font-src 'self' https: data:; frame-ancestors 'self';"

    # HSTS — enable after SSL is confirmed working (start with short max-age, then increase)
    # Header always set Strict-Transport-Security "max-age=300"
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── Gzip compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>

# ── Cache static assets ───────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg     "access plus 1 month"
    ExpiresByType image/jpeg    "access plus 1 month"
    ExpiresByType image/gif     "access plus 1 month"
    ExpiresByType image/png     "access plus 1 month"
    ExpiresByType image/webp    "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css                "access plus 1 week"
    ExpiresByType application/javascript  "access plus 1 week"
</IfModule>

