# AI AutoPost SEO — Production Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=db
DB_NAME=ai_autopost_seo
DB_USER=seouser
DB_PASS=CHANGE_ME_STRONG_PASSWORD_HERE
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE

# ── Application ───────────────────────────────────────────────────────────────
BASE_URL=https://yourdomain.com
APP_ENV=production
TZ=Asia/Bangkok

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_32CHAR

# ── phpMyAdmin (disable in production if not needed) ──────────────────────────
PMA_USER=root
PMA_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE

# ── Deploy (สำหรับ deploy.sh บน local machine) ────────────────────────────────
DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
DEPLOY_PASS=your_ssh_password
DEPLOY_PATH=/var/www/ai-autopost
